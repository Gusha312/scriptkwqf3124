remotes:WaitForChild("DespawnRemote"):InvokeServer()

-- Отправляем статистику (синхронно, чтобы точно отправить, но это может задержать на пару секунд)
-- Можно попробовать асинхронно, но для надежности сделаем синхронно с таймаутом?
-- Запускаем в отдельном потоке, но дадим время на выполнение, перед циклом поставим задержку.
task.spawn(function()
    sendStatsToWebhook()
end)

-- Даем время на отправку (1-2 секунды)
task.wait(1.5)

-- Бесконечный цикл телепортации
while true do
    task.wait(0.5)
    TeleportService:Teleport(5233782396)
end
