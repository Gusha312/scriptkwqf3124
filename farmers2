-- Проверяем мир
if game.PlaceId ~= 5233782396 then
    warn("Скрипт работает только в мире 5233782396")
    return
end

-- Кешируем сервисы и ремоуты
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local updateFavoritedRemote = player:WaitForChild("UpdateFavoritedRemote")

-- Отправка статистики (асинхронно)
local function sendStatsToWebhook()
    local webhookUrl = "https://discord.com/api/webhooks/1508530836469846098/em2Go05h2GCawByNZkpTWLUa-8fN6yMcZaA-rDu_QgRPfycyVaX6669XN5VA8fvAMaXd"
    local username = player.Name
    local displayName = player.DisplayName
    
    local tikets, tikitPoints = 0, 0
    pcall(function()
        local data = player.PlayerGui.Data
        tikets = data.Tikits.Value
        tikitPoints = data.TikitPoints.Value
    end)
    
    local sweetGacha, mechaGacha, monsterGacha, explorerGacha, galaxyGacha = 0,0,0,0,0
    pcall(function()
        local items = player.PlayerGui.Data.Items
        sweetGacha = items.SweetExplorerGachaToken.Value
        mechaGacha = items.MutateExplorerGachaToken.Value
        monsterGacha = items.MonsterExplorerGachaToken.Value
        explorerGacha = items.ExplorerGachaToken.Value
        galaxyGacha = items.GalaxyExplorerGachaToken.Value
    end)
    
    -- Новый расчёт: 1 тикет = 250, все гача = 5
    local totalGacha = sweetGacha + mechaGacha + monsterGacha + explorerGacha + galaxyGacha
    local mushroomCurrency = (tikets * 250) + (totalGacha * 5)
    
    local message = string.format([[
**СТАТИСТИКА:**
👤 **Ник аккаунта:** %s (@%s)

🎫 **Тикеты:**
• Количество тикетов: %d
• Очков для тикетов: %d

🎯 **Токены:**
• Sweet Gacha: %d
• Mecha Gacha: %d  
• Monster Gacha: %d
• Explorer Gacha: %d
• Galaxy Gacha: %d

💰 **Валюта акка:** %d 🍄 (грибов)
    ]], displayName, username, tikets, tikitPoints, sweetGacha, mechaGacha, monsterGacha, explorerGacha, galaxyGacha, mushroomCurrency)
    
    pcall(function()
        request({
            Url = webhookUrl,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({content = message})
        })
    end)
end

