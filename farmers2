remotes:WaitForChild("SetTutorialStageRemote"):InvokeServer("CreatureEditor", "Sochuri")
task.wait(0.15)
updateFavoritedRemote:FireServer(true, true)
task.wait(0.1)
remotes:WaitForChild("ConvertSpeciesRemote"):InvokeServer("Sochuri", 1)
