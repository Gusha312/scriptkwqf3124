--  СКРИПТ ФАРМА СЛОТОВ С ГАРАНТИРОВАННЫМИ КЛИКАМИ
--  КЛИКИ ПО ЦЕНТРУ + СМЕЩЕНИЕ ВНИЗ (БЕЗ ДРОЖАНИЯ)
--  КАЖДЫЙ КЛИК ПОВТОРЯЕТСЯ 3 РАЗА, ПРИ НЕУДАЧЕ – ПОВТОР
--  Нажмите F9 для вывода истории кликов.
-- ============================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ========== НАСТРОЙКИ ==========
local OFFSET_Y = 50          -- смещение вниз от центра (пиксели)
local CLICK_COUNT = 3        -- сколько кликов за одно нажатие
local MAX_RETRIES = 3        -- сколько раз пробовать, если кнопка не найдена

-- ========== ГЛОБАЛЬНАЯ ИСТОРИЯ КЛИКОВ ==========
_clickHistory = {}

local function addClickToHistory(posX, posY)
    table.insert(_clickHistory, {
        time = tick(),
        x = posX,
        y = posY
    })
end

function printClickHistory()
    print("\n📋 ИСТОРИЯ КЛИКОВ (всего " .. #_clickHistory .. " записей):")
    for i, entry in ipairs(_clickHistory) do
        print(string.format("  %2d) x=%.1f  y=%.1f  время=%.3f", i, entry.x, entry.y, entry.time))
    end
    print("")
end

-- Вывод истории по F9
game:GetService("UserInputService").InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.F9 then
        printClickHistory()
    end
end)

-- ========== РАНДОМАЙЗЕР (только для задержек) ==========
local rng = Random.new(tick() + math.random(1, 99999))

local function rwait(min, max)
    local base = rng:NextNumber(min, max)
    local jitter = rng:NextNumber(-0.05, 0.08)
    task.wait(math.max(0.05, base + jitter))
end

local function rint(min, max)
    return rng:NextInteger(min, max)
end

local function rnum(min, max)
    return rng:NextNumber(min, max)
end

-- ========== УЛУЧШЕННАЯ ФУНКЦИЯ КЛИКА ==========
local function forceExpandAndClick(button, retryCount)
    retryCount = retryCount or 0
    if retryCount >= MAX_RETRIES then
        print("❌ Не удалось найти кнопку после " .. MAX_RETRIES .. " попыток")
        return false
    end

    if not button then
        print("⚠️ Кнопка отсутствует (попытка " .. (retryCount+1) .. "/" .. MAX_RETRIES .. ")")
        task.wait(0.5)
        return false
    end

    -- Убедимся, что кнопка всё ещё существует и активна
    if not button.Parent then
        print("⚠️ Кнопка удалена из иерархии")
        return false
    end

    print("✅ Начинаем клик по кнопке: " .. button.Name)

    local oldSize = button.Size
    local oldPos = button.Position
    local oldZ = button.ZIndex
    local oldAnchor = button.AnchorPoint

    local viewportSize = Camera.ViewportSize
    local targetX = viewportSize.X / 2
    local targetY = viewportSize.Y / 2 + OFFSET_Y

    -- Раздувание с фиксированным большим размером
    local function applyMassive()
        button.AnchorPoint = Vector2.new(0.5, 0.5)
        button.Size = UDim2.new(0, 9999999, 0, 9999999)  -- максимальный размер
        button.Position = UDim2.new(0.5, 0, 0.5, 0)
        button.ZIndex = 9999999
        for _, child in pairs(button:GetChildren()) do
            if child:IsA("UIAspectRatioConstraint") then child.Enabled = false end
        end
    end

    -- Удерживаем раздувание и кликаем
    for i = 1, CLICK_COUNT do
        -- Раздуваем и держим
        local holdTime = rnum(0.4, 0.7)  -- увеличенное время удержания
        local t1 = tick()
        while tick() - t1 < holdTime do
            applyMassive()
            task.wait()
        end

        -- Клик
        local clickX, clickY = targetX, targetY
        addClickToHistory(clickX, clickY)
        print(string.format("  Клик #%d: (%.1f, %.1f)", i, clickX, clickY))

        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 0)
        rwait(0.06, 0.15)  -- чуть больше задержка
        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 0)

        if i < CLICK_COUNT then
            rwait(0.4, 0.7)  -- увеличенная пауза между кликами
        end
    end

    -- Восстанавливаем исходное состояние
    rwait(0.3, 0.6)
    button.AnchorPoint = oldAnchor
    button.Size = oldSize
    button.Position = oldPos
    button.ZIndex = oldZ

    print("✅ Клик завершён")
    return true
end

-- ========== ТЕЛЕПОРТЫ ==========
local function teleportTo(cframe)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
        char:PivotTo(cframe)
        rwait(0.08, 0.18)
        char:PivotTo(cframe)
    end
end

local function jitterCFrame(cf)
    local ox = rnum(-12, 12)
    local oy = rnum(-3, 3)
    local oz = rnum(-12, 12)
    return cf * CFrame.new(ox, oy, oz)
end

