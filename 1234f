local rng = Random.new(tick() + math.random(1, 99999))

local function rwait(min, max)
    task.wait(math.max(0.05, rng:NextNumber(min, max)))
end

local function clickElementSecure(element, clicks)
    if not element or not element:IsA("GuiObject") then return false end
    local oParent, oSize, oPos = element.Parent, element.Size, element.Position
    local oAnchor, oZ, oVis, oActive = element.AnchorPoint, element.ZIndex, element.Visible, element.Active

    local tempGui = Instance.new("ScreenGui")
    tempGui.Name = "HudLayer" .. tostring(rng:NextInteger(1000, 9999))
    tempGui.IgnoreGuiInset = true
    tempGui.DisplayOrder = rng:NextInteger(900000, 1100000)
    tempGui.Parent = player.PlayerGui

    element.Parent = tempGui
    element.Visible = true
    element.Active = true
    element.AnchorPoint = Vector2.new(0.5, 0.5)
    element.Position = UDim2.new(0.5, 0, 0.5, 0)
    element.Size = UDim2.new(0, rng:NextInteger(7000, 9999), 0, rng:NextInteger(7000, 9999))
    element.ZIndex = rng:NextInteger(900000, 1000000)

    rwait(0.25, 0.45)

    if element.AbsoluteSize.X > 0 and element.AbsoluteSize.Y > 0 then
        local vp = camera.ViewportSize
        local cx, cy = vp.X / 2, vp.Y / 2
        for i = 1, (clicks or 1) do
            local jx = cx + rng:NextNumber(-3, 3)
            local jy = cy + rng:NextNumber(-3, 3)
            VirtualInputManager:SendMouseButtonEvent(jx, jy, 0, true, game, 1)
            rwait(0.07, 0.18)
            VirtualInputManager:SendMouseButtonEvent(jx, jy, 0, false, game, 1)
            if i < (clicks or 1) then rwait(0.15, 0.35) end
        end
    else
        warn("нулевой размер элемента")
    end

    rwait(0.4, 0.7)
    element.Parent, element.Size, element.Position = oParent, oSize, oPos
    element.AnchorPoint, element.ZIndex, element.Visible, element.Active = oAnchor, oZ, oVis, oActive
    tempGui:Destroy()
    return true
end

local function mountDragon()
    local gui = player.PlayerGui:WaitForChild("WorkspaceGui")
    local key = "Workspace.Characters." .. player.Name .. ".Dragons.1.HumanoidRootPart"
    local okPath, container = pcall(function() return gui[key].ContainerFrame end)
    if not okPath or not container then
        warn("ContainerFrame дракона не найден — пропускаю посадку")
        return
    end
    local interactBtn = container:FindFirstChild("InteractButton")
    if interactBtn then
        print("Посадка: жму InteractButton")
        clickElementSecure(interactBtn, 1)
    end
    rwait(0.6, 1.0)
    local optionsFrame = container:FindFirstChild("OptionsFrame")
    if not optionsFrame then warn("OptionsFrame не найден"); return end
    local rideBtn
    for _, child in ipairs(optionsFrame:GetChildren()) do
        if child:IsA("GuiObject") and child.Name:match("^Default") then
            local hint = child:FindFirstChild("ActionHintLabel")
            if hint and hint:IsA("TextLabel") and hint.Text == "Ride" then
                rideBtn = child
                break
            end
        end
    end
    if rideBtn then
        print("Посадка: нашёл Ride →", rideBtn:GetFullName())
        clickElementSecure(rideBtn, rng:NextInteger(2, 3))
    else
        warn("Кнопка 'Ride' не найдена")
    end
end

