        print("[BOSS] GUI наград не найден")
        return
    end
    print("[BOSS] Собираем награды")
    task.wait(1)

    local chestsFrame = LootFrame:FindFirstChild("ChestsFrame")
    local bestChest = nil
    if chestsFrame then
        for _, chestNum in ipairs({"3","2","1"}) do
