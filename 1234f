local function universalEggMission(worldName, needed)
    local missions = getMissionsFolder(worldName)
    if not missions then return end
    local egg = missions:FindFirstChild("EggQuest")
    if not egg or egg.Value == true then return end
    local progress = egg:WaitForChild("Progress")
    if progress.Value >= needed then return end
    print(string.format("[EGG] %s: нужно %d (сейчас %d)", worldName, needed, progress.Value))
    local collectRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CollectEggRemote")
    local hrp = getHRP()
    local function getActiveBase()
        local activeRoot = workspace.Interactions.Nodes.Eggs.ActiveNodes
        local activeNode = activeRoot:FindFirstChild(worldName) or activeRoot:FindFirstChild(dataNameFor(worldName))
        if not activeNode then return nil end
        local base = activeNode:FindFirstChild("Base")
        if not base then return nil end
        return base:IsA("BasePart") and base.CFrame or (base:IsA("Model") and base.PrimaryPart and base.PrimaryPart.CFrame)
    end
    local function findActiveNestId(baseCFrame)
        local eggsFolder = workspace.Interactions.Nodes.Eggs
        for i = 1, 20 do
            local nestObj = eggsFolder:FindFirstChild(tostring(i))
            if nestObj then
                local nest = nestObj:FindFirstChild("Nest")
                if nest then
                    local nestPos = nil
                    if nest:IsA("CFrameValue") then
                        nestPos = nest.Value.Position
                    elseif nest:IsA("Vector3Value") then
                        nestPos = nest.Value
                    elseif nest:IsA("BasePart") then
                        nestPos = nest.Position
                    elseif nest:IsA("Model") then
                        local valObj = nest:FindFirstChild("Value")
                        if valObj then
                            if valObj:IsA("CFrameValue") then
                                nestPos = valObj.Value.Position
                            elseif valObj:IsA("Vector3Value") then
                                nestPos = valObj.Value
                            end
                        end
                    end
                    if nestPos and (nestPos - baseCFrame.Position).Magnitude < 5 then return i end
                end
            end
        end
        return nil
    end
    local attempts = 0
    while progress.Value < needed do
        local baseCF = getActiveBase()
        if not baseCF then
            print("[EGG] Base не найдена — летим искать")
            flyUntilFound(getActiveBase, 30)
            baseCF = getActiveBase()
            attempts = 0
        end
        if not baseCF then
            task.wait(2)
        else
            local nestId = findActiveNestId(baseCF)
            if not nestId then
                print("[EGG] Гнездо не найдено")
                task.wait(2)
                attempts = 0
            else
                local before = progress.Value
                hrp.CFrame = baseCF * CFrame.new(0,5,0)
                task.wait(0.5)
                if (hrp.Position - baseCF.Position).Magnitude > 20 then
                    print("[EGG] Телепорт не удался")
                    task.wait(1)
                else
                    pcall(function() collectRemote:InvokeServer(tostring(nestId)) end)
                    task.wait(1.5)
                    if progress.Value > before then
                        print(string.format("[EGG] Успешно! %d/%d", progress.Value, needed))
                        attempts = 0
                        task.wait(6)
                    else
                        attempts = attempts + 1
                        print(string.format("[EGG] Без прогресса (%d/3)", attempts))
                        if attempts >= 3 then
                            print("[EGG] Слишком много неудач, выход")
                            break
                        end
                        task.wait(3)
                    end
                end
            end
        end
    end
    print("[EGG] Завершено")
end

