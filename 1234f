local discoveredCFrames = {}
local roamIndex = 0
local DEDUPE_DIST = 10

local function recordCFrame(cf)
    for _, saved in ipairs(discoveredCFrames) do
        if (saved.Position - cf.Position).Magnitude < DEDUPE_DIST then return end
    end
    table.insert(discoveredCFrames, cf)
    print("Записано дерево #" .. #discoveredCFrames)
end

