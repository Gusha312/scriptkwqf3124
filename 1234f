local function getMobsInRadius(position, radius)
    local mobs = {}
    local folder = workspace:FindFirstChild("MobFolder")
    if not folder then return mobs end
    for _, mob in ipairs(folder:GetChildren()) do
        local root = mob:FindFirstChild(mob.Name)
        if root then
            local hok, health = pcall(function() return root:FindFirstChild("Health").Value end)
            if hok and health and health > 0 and (position - root.Position).Magnitude <= radius then
                table.insert(mobs, root)
            end
        end
    end
    return mobs
end

local function clearMobsAtSpawn(spawnCF, rad, slot)
    local hrp = getHRP()
    local function isMobAlive(root)
        local ok, h = pcall(function() return root:FindFirstChild("Health").Value end)
        return ok and h and h > 0
    end

    print("[BOSS] Зачистка мобов")
    hrp.CFrame = CFrame.new(spawnCF.Position + Vector3.new(0, 5, 0))
    task.wait(1)

    local startTime = tick()
    while tick() - startTime < 30 do
        local mobs = getMobsInRadius(spawnCF.Position, rad)
        local okSp, sp = pcall(function() return slot.SpawnPart end)
        if okSp and sp then
            for _, m in ipairs(getMobsInRadius(sp.Position, rad)) do
                local found = false
                for _, e in ipairs(mobs) do if e == m then found = true; break end end
                if not found then table.insert(mobs, m) end
            end
        end

        if #mobs == 0 then break end

        for _, mobRoot in ipairs(mobs) do
            if isMobAlive(mobRoot) then
                hrp.CFrame = CFrame.new(mobRoot.Position + Vector3.new(0, 5, 0))
                task.wait(0.4)
                local attackCount = 0
                while isMobAlive(mobRoot) and attackCount < 4 do
                    fireAttack("Mobs", mobRoot)
                    task.wait(0.25)
                    attackCount = attackCount + 1
                end
                task.wait(0.2)
            end
        end
        task.wait(0.5)
    end
    hrp.CFrame = CFrame.new(spawnCF.Position + Vector3.new(0, 5, 0))
    task.wait(1)
end

local function clickGuiButton(button)
    if not button then return false end
    if VIM then
        local upper = button:FindFirstChild("UpperLabel")
        local target = upper or button
        local origSize, origPos, origAnchor, origZIndex = target.Size, target.Position, target.AnchorPoint, target.ZIndex
        target.Size = UDim2.new(100, 0, 100, 0)
        target.Position = UDim2.new(0.5, 0, 0.5, 0)
        target.AnchorPoint = Vector2.new(0.5, 0.5)
        target.ZIndex = 99999
        task.wait(0.3)
        local screen = workspace.CurrentCamera.ViewportSize
        VIM:SendMouseButtonEvent(math.floor(screen.X/2), math.floor(screen.Y/2), 0, true, game, 1)
        task.wait(0.1)
        VIM:SendMouseButtonEvent(math.floor(screen.X/2), math.floor(screen.Y/2), 0, false, game, 1)
        task.wait(0.3)
        target.Size = origSize; target.Position = origPos; target.AnchorPoint = origAnchor; target.ZIndex = origZIndex
        return true
    end
    return false
end

