local function universalHarvestMission(worldName)
    local missions = getMissionsFolder(worldName)
    if not missions then return end
    local harv = missions:FindFirstChild("Harvest")
    if not harv or harv.Value == true then return end
    local progress = harv:WaitForChild("Progress")
    local target = params.harvestTarget
    print(string.format("[HARVEST] %s: нужно %d", worldName, target))
    local char = waitForCharacter()
    local hrp = getHRP()
    local dragonRemote = char:WaitForChild("Dragons"):WaitForChild("1"):WaitForChild("Remotes"):WaitForChild("PlaySoundRemote")
    local dropRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("LargeNodeDropsRemote")
    local function findNode()
        local nodes = workspace.Interactions.Nodes
        local worldNodes = nodes:FindFirstChild(worldName) or nodes:FindFirstChild(dataNameFor(worldName))
        if worldNodes then
            for _, cat in ipairs({"Food", "Resources"}) do
                local folder = worldNodes:FindFirstChild(cat)
                if folder then
                    for _, node in ipairs(folder:GetChildren()) do
                        local bp = node:FindFirstChild("BillboardPart")
                        if bp and bp:FindFirstChild("Health") and bp.Health.Value > 0 then return bp end
                    end
                end
            end
        end
        for _, cat in ipairs({"Food", "Resources"}) do
            local folder = nodes:FindFirstChild(cat)
            if folder then
                for _, node in ipairs(folder:GetChildren()) do
                    local bp = node:FindFirstChild("BillboardPart")
                    if bp and bp:FindFirstChild("Health") and bp.Health.Value > 0 then return bp end
                end
            end
        end
        return nil
    end
    local questDone = false
    harv:GetPropertyChangedSignal("Value"):Connect(function()
        if harv.Value == true then
            questDone = true
            print("[HARVEST] Сервер подтвердил завершение квеста")
        end
    end)

    while progress.Value < target and not questDone and harv.Value ~= true do
        local targetPart = findNode()
        if not targetPart then
            print("[HARVEST] Нет узлов — летим искать")
            targetPart = flyUntilFound(findNode, 30)
            if not targetPart then
                print("[HARVEST] Узлы не найдены после полёта, ждём 3 сек")
                task.wait(3)
            end
        end
        if targetPart then
            hrp.CFrame = targetPart.CFrame
            while targetPart and targetPart:FindFirstChild("Health") and targetPart.Health.Value > 0 and progress.Value < target do
                dragonRemote:FireServer("Breath", "Destructibles", targetPart)
                task.wait(0.05)
            end
            local endTime = tick() + 5
            while tick() < endTime and progress.Value < target do
                for stage = 1, 6 do
                    if progress.Value >= target then break end
                    dropRemote:FireServer(targetPart, stage, 3)
                    task.wait(0.1)
                    if progress.Value >= target then break end
                    dropRemote:FireServer(targetPart, stage, 2)
                    task.wait(0.1)
                    if progress.Value >= target then break end
                    dropRemote:FireServer(targetPart, stage, 1)
                    task.wait(0.1)
                end
                task.wait(0.05)
            end
            print(string.format("[HARVEST] %s: %d/%d", worldName, progress.Value, target))
        end
    end
    print("[HARVEST] Готово")
end

