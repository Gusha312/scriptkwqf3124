local function universalKillMobsMission(worldName)
    local missions = getMissionsFolder(worldName)
    if not missions then return end
    local mob = missions:FindFirstChild("KillMobs")
    if not mob or mob.Value == true then return end
    local progress = mob:WaitForChild("Progress")
    local target = params.killMobsTarget
    print(string.format("[KILLMOBS] %s: нужно %d мобов", worldName, target))
    local hrp = getHRP()
    local char = waitForCharacter()
    local function getPlaySound()
        local dragons = char:FindFirstChild("Dragons")
        if not dragons then return nil end
        for _, d in ipairs(dragons:GetChildren()) do
            local r = d:FindFirstChild("Remotes")
            if r then
                local ps = r:FindFirstChild("PlaySoundRemote")
                if ps then return ps end
            end
        end
        return nil
    end
    local ps = getPlaySound()
    if not ps then return end
    local function attack(mobRoot)
        pcall(function() ps:FireServer("Breath", "Mobs", mobRoot) end)
    end
    local function getMobsInRadius(rad)
        local mobs = {}
        local folder = workspace:FindFirstChild("MobFolder")
        if not folder then return mobs end
        local pos = hrp.Position
        for _, m in ipairs(folder:GetChildren()) do
            local root = m:FindFirstChild(m.Name)
            if root and root:FindFirstChild("Health") and root.Health.Value > 0 and (pos - root.Position).Magnitude <= rad then
                table.insert(mobs, root)
            end
        end
        return mobs
    end
    while progress.Value < target do
        local mobs = getMobsInRadius(50)
        if #mobs == 0 then
            local all = {}
            local folder = workspace:FindFirstChild("MobFolder")
            if folder then
                for _, m in ipairs(folder:GetChildren()) do
                    local root = m:FindFirstChild(m.Name)
                    if root and root:FindFirstChild("Health") and root.Health.Value > 0 then
                        table.insert(all, root)
                    end
                end
            end
            if #all > 0 then
                table.sort(all, function(a,b) return (hrp.Position - a.Position).Magnitude < (hrp.Position - b.Position).Magnitude end)
                hrp.CFrame = CFrame.new(all[1].Position + Vector3.new(0,5,0))
                task.wait(0.3)
            else
                print("[KILLMOBS] Мобов нет — летим искать")
                flyUntilFound(function()
                    local fld = workspace:FindFirstChild("MobFolder")
                    if not fld then return nil end
                    for _, m in ipairs(fld:GetChildren()) do
                        local root = m:FindFirstChild(m.Name)
                        if root and root:FindFirstChild("Health") and root.Health.Value > 0 then
                            return root
                        end
                    end
                    return nil
                end, 30)
            end
        else
            for _, m in ipairs(mobs) do
                if progress.Value >= target then break end
                attack(m)
                task.wait(0.15)
            end
            task.wait(0.3)
        end
    end
    print("[KILLMOBS] Готово")
end

