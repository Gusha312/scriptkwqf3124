        universalKillBossMission(worldName)
        universalSpendTimeMission(worldName, nextWorld)
    end
end

local function waitForMissionsData(worldName, timeout)
    timeout = timeout or 30
    local start = tick()
    while tick() - start < timeout do
        local missions = getMissionsFolder(worldName)
        if missions and #missions:GetChildren() > 0 then
            print("[DATA] Миссии мира " .. worldName .. " загружены")
            return true
        end
        task.wait(1)
    end
    print("[DATA] Миссии мира " .. worldName .. " не загрузились за " .. timeout .. " сек")
    return false
end

-- ------------------------------------------------------------
--  ПРОХОД МИРА ПОЛНОСТЬЮ (С ОСОБОЙ ОБРАБОТКОЙ PREHISTORIC)  [ИЗМЕНЕНИЕ]
-- ------------------------------------------------------------
local function completeWorldFully(worldName, nextWorld)
    -- Специальная обработка для Prehistoric – используем безопасный сбор
    if worldName == "Prehistoric" then
        print("[PREHISTORIC] Используем безопасный сбор для Harvest, остальные квесты – стандартно")
        waitForMissionsData(worldName, 30)
        local pass = 0
        while not isWorldComplete(worldName) do
            pass = pass + 1
            print(string.format("[МИР] %s — проход миссий #%d", worldName, pass))
            safeHarvestMission(worldName)           -- вместо universalHarvestMission
            universalTreasureMission(worldName)
            universalEggMission(worldName, params.eggTarget)
            universalKillMobsMission(worldName)
            if hasBossAndSpend[worldName] then
                universalKillBossMission(worldName)
                universalSpendTimeMission(worldName, nextWorld)
            end
            if isWorldComplete(worldName) then break end
            if nextWorld and isWorldUnlocked(nextWorld) then
                print("[МИР] Следующий мир открыт — текущий считаем пройденным")
                break
            end
            task.wait(2)
        end
        print("[МИР] " .. worldName .. " завершён")
        return
    end

    -- Для всех остальных миров – стандартный проход
    waitForMissionsData(worldName, 30)
    local pass = 0
    while not isWorldComplete(worldName) do
        pass = pass + 1
        print(string.format("[МИР] %s — проход миссий #%d", worldName, pass))
        completeWorldMissions(worldName, nextWorld)
        if isWorldComplete(worldName) then break end
        if nextWorld and isWorldUnlocked(nextWorld) then
            print("[МИР] Следующий мир открыт — текущий считаем пройденным")
            break
        end
        task.wait(2)
    end
    print("[МИР] " .. worldName .. " завершён")
end

-- ------------------------------------------------------------
--  ОСНОВНОЙ ЦИКЛ ПЕРЕХОДА МЕЖДУ МИРАМИ
-- ------------------------------------------------------------
local function main()
    print("[СКРИПТ] Запуск прохождения миров")
    repeat task.wait(2) until pcall(function() return player.Data.Worlds end)

    local targetWorld = nil
    for i = #worldsOrder, 1, -1 do
        local w = worldsOrder[i]
        if isWorldUnlocked(w) and not isWorldComplete(w) then
            targetWorld = w
            print("[СТАРТ] Цель — открытый непройденный мир: " .. w)
            break
        end
    end
    if not targetWorld then
        for i = #worldsOrder, 1, -1 do
            local w = worldsOrder[i]
            if isWorldUnlocked(w) then
                targetWorld = w
                print("[СТАРТ] Все открытые миры пройдены, идём в последний открытый: " .. w)
                break
            end
        end
    end
    if not targetWorld then
        local w = worldsOrder[1]
        print("[СТАРТ] Ничего не открыто, ждём " .. w)
        while not isWorldUnlocked(w) do task.wait(5) end
        targetWorld = w
    end

    if game.PlaceId ~= worldPlaceIds[targetWorld] then teleportToWorld(targetWorld) end

    local currentIndex = nil
    for i = 1, #worldsOrder do
        if worldsOrder[i] == targetWorld then currentIndex = i; break end
    end
    if not currentIndex then error("Не удалось найти индекс мира") end

    while currentIndex <= #worldsOrder do
        local currentWorld = worldsOrder[currentIndex]
        local nextWorld = worldsOrder[currentIndex + 1]
        if game.PlaceId ~= worldPlaceIds[currentWorld] then teleportToWorld(currentWorld) end

        -- Проходим мир (Prehistoric обрабатывается внутри completeWorldFully)
        if currentWorld == "Prehistoric" or not isWorldComplete(currentWorld) then
            completeWorldFully(currentWorld, nextWorld)
        else
            print("[МИР] " .. currentWorld .. " уже пройден")
        end

        if not nextWorld then break end

        if isWorldUnlocked(nextWorld) then
            print("[ОТКРЫТИЕ] Мир " .. nextWorld .. " уже открыт!")
        else
            print(string.format("[ОЖИДАНИЕ] Ждём открытия мира %s (проверка каждые 5 сек)", nextWorld))
            while not isWorldUnlocked(nextWorld) do
                task.wait(5)
            end
            print("[ОТКРЫТИЕ] Мир " .. nextWorld .. " открылся!")
        end

        currentIndex = currentIndex + 1
        local goWorld = worldsOrder[currentIndex]
        print("[ПЕРЕХОД] Телепорт в новый мир: " .. goWorld)
        if game.PlaceId ~= worldPlaceIds[goWorld] then
            teleportToWorld(goWorld)
        end
    end
    print("[СКРИПТ] Все миры пройдены!")
end

-- ------------------------------------------------------------
--  ЗАПУСК
-- ------------------------------------------------------------
local success, err = pcall(main)
if not success then
    warn("[ОШИБКА] " .. tostring(err))
end
