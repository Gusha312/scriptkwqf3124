local oldHook
local lastMobDamageTick = 0
oldHook = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if (method == "FireServer" or method == "fireServer") and tostring(self) == "MobDamageRemote" and self:IsDescendantOf(ReplicatedStorage) then
        if tick() - lastMobDamageTick >= 5 then
            lastMobDamageTick = tick()
            return oldHook(self, ...)
        else
            return nil
        end
    end
    return oldHook(self, ...)
end)

