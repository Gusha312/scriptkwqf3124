local function universalTreasureMission(worldName)
    local missions = getMissionsFolder(worldName)
    if not missions then return end
    local chest = missions:FindFirstChild("TreasureChest")
    if not chest then return end
    if chest.Value == true then
        print("[TREASURE] Квест уже завершён, пропускаем")
        return
    end
    local progress = chest:WaitForChild("Progress")
    local target = params.chestTarget
    if progress.Value >= target then
        print(string.format("[TREASURE] Прогресс уже %d/%d, пропускаем", progress.Value, target))
        return
    end
    print(string.format("[TREASURE] %s: нужно %d сундуков (сейчас %d)", worldName, target, progress.Value))
    local char = waitForCharacter()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        warn("[TREASURE] Нет HumanoidRootPart")
        return
    end
    local openRemote = player:WaitForChild("Remotes"):WaitForChild("OpenChestRemote")
    local dropsRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TreasureChestDropsRemote")
    local function setBreathFire(on)
        local dragons = char:FindFirstChild("Dragons")
        if not dragons then return end
        local dragon = dragons:FindFirstChild("1")
        if not dragon then return end
        local remotes = dragon:FindFirstChild("Remotes")
        if not remotes then return end
        local breathRemote = remotes:FindFirstChild("BreathFireRemote")
        if breathRemote then breathRemote:FireServer(on) end
    end
    local function getAllChests()
        local result = {}
        local treasureFolder = workspace:FindFirstChild("Interactions")
            and workspace.Interactions:FindFirstChild("Nodes")
            and workspace.Interactions.Nodes:FindFirstChild("Treasure")
        if not treasureFolder then
            warn("[TREASURE] Папка Treasure не найдена в Nodes")
            return result
        end
        for _, obj in ipairs(treasureFolder:GetChildren()) do
            table.insert(result, obj)
        end
        return result
    end
    local function teleportToChest(obj)
        local cframe = nil
        if obj:IsA("BasePart") then
            cframe = obj.CFrame
        elseif obj:IsA("Model") then
            if obj.PrimaryPart then
                cframe = obj.PrimaryPart.CFrame
            else
                local part = obj:FindFirstChildWhichIsA("BasePart", true)
                if part then cframe = part.CFrame end
            end
        end
        if cframe then
            hrp.CFrame = cframe * CFrame.new(0, 5, 0)
            print("[TREASURE] Телепорт к сундуку:", obj.Name)
        else
            warn("[TREASURE] Не удалось найти позицию для:", obj.Name)
        end
        task.wait(0.5)
    end

    local dataFolderName = dataNameFor(worldName)
    local chestsList = getAllChests()
    if #chestsList == 0 then
        print("[TREASURE] Сундуки не найдены сразу, основной цикл будет искать через еду")
    end

    local questDone = false
    chest:GetPropertyChangedSignal("Value"):Connect(function()
        if chest.Value == true then
            questDone = true
            print("[TREASURE] Сервер подтвердил завершение квеста")
        end
    end)

    while progress.Value < target and not questDone and chest.Value ~= true do
        chestsList = getAllChests()
        if #chestsList == 0 then
            print("[TREASURE] Нет сундуков — телепорт к еде + полёт на прогрузку")
            teleportToAnyFood(worldName)
            task.wait(3)
            chestsList = getAllChests()
            if #chestsList == 0 then
                flyUntilFound(function()
                    local found = getAllChests()
                    return (#found > 0) and found or nil
                end, 30)
                chestsList = getAllChests()
            end
        else
            for _, c in ipairs(chestsList) do
                if progress.Value >= target or questDone or chest.Value == true then break end
                if not c or not c.Parent then continue end
                local num = tonumber(c.Name) or tonumber(string.match(c.Name, "%d+"))
                if not num then
                    warn("[TREASURE] Не удалось получить id сундука:", c.Name)
                    continue
                end
                print("[TREASURE] Обработка сундука #" .. num)
                teleportToChest(c)
                task.wait(1)
                setBreathFire(true)
                task.wait(0.2)
                for i = 1, 5 do
                    pcall(function() openRemote:InvokeServer(i, false) end)
                    task.wait(0.1)
                end
                task.wait(1)
                local dataChest = nil
                pcall(function()
                    dataChest = player.Data.TreasureChests[dataFolderName][tostring(num)]
                end)
                if dataChest then
                    for _, stage in ipairs({1, 2, 3, 4, 4}) do
                        pcall(function() dropsRemote:FireServer(dataChest, stage) end)
                        task.wait(0.2)
                    end
                else
                    warn(string.format("[TREASURE] Нет данных для сундука #%d", num))
                end
                setBreathFire(false)
                if c and c.Parent then
                    c:Destroy()
                    print("[TREASURE] Сундук #" .. num .. " удалён")
                end
                task.wait(0.3)
                print(string.format("[TREASURE] Прогресс: %d/%d", progress.Value, target))
            end
        end
        task.wait(1)
    end
    print("[TREASURE] Выполнено")
end

