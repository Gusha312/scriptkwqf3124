local foodTeleportIndex = 0

local function teleportToAnyFood(worldName)
    local nodes = workspace.Interactions.Nodes
    local allParts = {}
    local worldNodes = nodes:FindFirstChild(worldName) or nodes:FindFirstChild(dataNameFor(worldName))
    if worldNodes then
        for _, cat in ipairs({"Food", "Resources"}) do
            local folder = worldNodes:FindFirstChild(cat)
            if folder then
                for _, node in ipairs(folder:GetChildren()) do
                    local bp = node:FindFirstChild("BillboardPart")
                    if bp then table.insert(allParts, bp) end
                end
            end
        end
    end
    if #allParts == 0 then
        for _, cat in ipairs({"Food", "Resources"}) do
            local folder = nodes:FindFirstChild(cat)
            if folder then
                for _, node in ipairs(folder:GetChildren()) do
                    local bp = node:FindFirstChild("BillboardPart")
                    if bp then table.insert(allParts, bp) end
                end
            end
        end
    end
    if #allParts == 0 then return false end
    foodTeleportIndex = (foodTeleportIndex % #allParts) + 1
    local targetPart = allParts[foodTeleportIndex]
    local hrp = getHRP()
    hrp.CFrame = targetPart.CFrame * CFrame.new(0, 5, 0)
    print(string.format("[TELEPORT] Телепорт к еде #%d/%d для прогрузки карты", foodTeleportIndex, #allParts))
    task.wait(1)
    return true
end

