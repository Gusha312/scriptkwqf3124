        end
    end
    print("[BOSS] Награды собраны!")
end

local function runBossCycle()
    reviveDragon()
    local hrp = getHRP()

    local fightId = nil
    local queueAttempts = 0
    while not fightId do
        queueAttempts = queueAttempts + 1
        print("[BOSS] Очередь (попытка " .. queueAttempts .. ")")
        pcall(function() ReplicatedStorage:WaitForChild("Remotes").CreateBossQueueRemote:InvokeServer("Everyone") end)
        pcall(function() ReplicatedStorage:WaitForChild("Remotes").StartBossQueueRemote:InvokeServer() end)
        waitUntil(function() fightId = getFightId(); return fightId ~= nil end, 15, 0.5)
        if not fightId then
            reviveDragon()
            cachedPlaySound = nil
            task.wait(5)
        end
    end
    print("[BOSS] FightId:", fightId)

    local slot = nil
    local tpAttempts = 0
    while not slot do
        tpAttempts = tpAttempts + 1
        print("[BOSS] Телепорт к боссу (попытка " .. tpAttempts .. ")")
        pcall(function() ReplicatedStorage:WaitForChild("Remotes").GetTeleportRemote:InvokeServer("ToBossInstance", {FightId = fightId, Spawn = true}) end)
        for _ = 1, 16 do
            task.wait(0.5)
            slot = getSlot()
            if slot then break end
        end
        if not slot then
            local stillExists = getFightId()
            if not stillExists then
                print("[BOSS] Бой пропал во время телепорта, пересоздаём")
                return false
            end
            task.wait(2)
        end
    end
    print("[BOSS] Слот:", slot.Name)

    local function tpToSpawn()
        local ok, sp = pcall(function() return slot.SpawnPart end)
        if not ok or not sp then return end
        for _ = 1, 15 do
            hrp.CFrame = CFrame.new(sp.Position + Vector3.new(0, 5, 0))
            task.wait(0.3)
            if (hrp.Position - sp.Position).Magnitude < 25 then return end
        end
    end
    tpToSpawn()

    if not waitUntil(function() return bossExists(fightId) end, 30, 0.5) then
        print("[BOSS] Босс не появился"); return false
    end
    print("[BOSS] Босс появился")

    local stage1 = true
    task.spawn(function()
        while stage1 do
            local ok, root = pcall(function() return workspace.ActiveBossModels[fightId].HumanoidRootPart end)
            if ok and root then attackBoss(root) end
            task.wait(0.25)
        end
    end)
    task.spawn(function()
        while stage1 do
            local ok, sp = pcall(function() return slot.SpawnPart end)
            if ok and sp and (hrp.Position - sp.Position).Magnitude > 100 then
                hrp.CFrame = CFrame.new(sp.Position + Vector3.new(0, 5, 0))
            end
            task.wait(1)
        end
    end)
    while getStage(fightId) ~= 2 do task.wait(0.5) end
    stage1 = false
    task.wait(1)

    print("[BOSS] Stage 2 - мобы")
    for _, n in ipairs({3,2,1,4}) do
        if getStage(fightId) == 3 then break end
        local ok, sp = pcall(function() return slot.MobSpawns[tostring(n)] end)
        if ok and sp then clearMobsAtSpawn(sp.CFrame, 150, slot); task.wait(2) end
    end
    while getStage(fightId) ~= 3 do
        for _, n in ipairs({3,2,1,4}) do
            if getStage(fightId) == 3 then break end
            local ok, sp = pcall(function() return slot.MobSpawns[tostring(n)] end)
            if ok and sp then clearMobsAtSpawn(sp.CFrame, 150, slot); task.wait(2) end
        end
        task.wait(1)
    end

    print("[BOSS] Stage 3 - финал")
    tpToSpawn()
    local stage3 = true
    task.spawn(function()
        while stage3 do
            local ok, root = pcall(function() return workspace.ActiveBossModels[fightId].HumanoidRootPart end)
            if ok and root then attackBoss(root) end
            task.wait(0.25)
        end
    end)
    task.spawn(function()
        while stage3 do
            local ok, sp = pcall(function() return slot.SpawnPart end)
            if ok and sp and (hrp.Position - sp.Position).Magnitude > 100 then
                hrp.CFrame = CFrame.new(sp.Position + Vector3.new(0, 5, 0))
            end
            task.wait(1)
        end
    end)
    while not isDead(fightId) do task.wait(0.2) end
    stage3 = false
    print("[BOSS] Босс убит")

    collectLoot()

    waitUntil(function()
        local ok, inst = pcall(function() return workspace.Interactions.Boss.BossInstances[fightId] end)
        return not ok or not inst or not inst.Parent
    end, 30, 0.5)
    return true
end

local function universalKillBossMission(worldName)
    print(string.format("[BOSS] %s: убиваем босса", worldName))
    local attempt = 0
    while true do
        attempt = attempt + 1
        local ok = runBossCycle()
        if ok then
            print("[BOSS] Босс успешно убит с попытки " .. attempt)
            break
        end
        print("[BOSS] Цикл прерван, пробуем заново (попытка " .. attempt .. ")")
        reviveDragon()
        cachedPlaySound = nil
        task.wait(3)
    end
end

local function getSpendTimeMission(worldName)
    local missions = getMissionsFolder(worldName)
    if not missions then return nil end
    return missions:FindFirstChild("SpendTime")
end

local function universalSpendTimeMission(worldName, nextWorld)
    local mission = getSpendTimeMission(worldName)
    if mission then
        local ok, val = pcall(function() return mission.Value end)
        if ok and val == true then
            print("[SPENDTIME] Квест уже выполнен, пропускаем")
            return
        end
    end

    print(string.format("[SPENDTIME] %s: ожидание до %d сек (проверка каждые 5 сек)", worldName, params.spendTimeSeconds))
    local startTime = tick()
    while tick() - startTime < params.spendTimeSeconds do
        task.wait(5)
        if mission then
            local ok, val = pcall(function() return mission.Value end)
            if ok and val == true then
                print("[SPENDTIME] Квест выполнен сервером, выходим")
                return
            end
        end
        if nextWorld and isWorldUnlocked(nextWorld) then
            print("[SPENDTIME] Следующий мир (" .. nextWorld .. ") открылся — прерываем ожидание")
            return
        end
        if isWorldComplete(worldName) then
            print("[SPENDTIME] Все миссии мира выполнены, выходим")
            return
        end
    end
    print("[SPENDTIME] Время ожидания истекло")
end

