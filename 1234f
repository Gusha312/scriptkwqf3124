local FLY_DIRS = {
    Vector3.new(0, 0, -1),
    Vector3.new(0, 0,  1),
    Vector3.new(-1, 0, 0),
    Vector3.new(1, 0,  0),
}

local function flyRandom(distance, steps)
    distance = distance or 120
    steps = steps or 6
    local hrp = getHRP()
    local dir = FLY_DIRS[math.random(1, #FLY_DIRS)]
    local stepDist = distance / steps
    for _ = 1, steps do
        hrp.CFrame = hrp.CFrame + dir * stepDist
        task.wait(0.2)
    end
end

local function isToxicWorld()
    return game.PlaceId == worldPlaceIds.Wasterland
end

local function flyUntilFound(finder, maxFlights)
    maxFlights = maxFlights or 100
    local found = finder()
    if found then return found end
    if not isToxicWorld() then return nil end
    local hrp = getHRP()
    for flight = 1, maxFlights do
        local dir = FLY_DIRS[math.random(1, #FLY_DIRS)]
        for _ = 1, 6 do
            hrp.CFrame = hrp.CFrame + dir * 60
            task.wait(0.2)
            found = finder()
            if found then
                print("[ПОЛЁТ] Объект найден после полёта")
                return found
            end
        end
    end
    return nil
end

local function teleportToWorld(worldName)
    local placeId = worldPlaceIds[worldName]
    if not placeId then error("Неизвестный мир") end
    print("[ТЕЛЕПОРТ] → " .. worldName)
    local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("WorldTeleportRemote")
    local attempt = 0
    while game.PlaceId ~= placeId do
        attempt = attempt + 1
        print(string.format("[ТЕЛЕПОРТ] Отправка запроса в %s (попытка %d)", worldName, attempt))
        pcall(function() remote:InvokeServer(placeId, {}) end)
        local waited = 0
        while game.PlaceId ~= placeId and waited < 10 do
            task.wait(1)
            waited = waited + 1
        end
    end
    waitForCharacter()
    task.wait(3)
    print("[ТЕЛЕПОРТ] Успешно в " .. worldName)
end

local function dataNameFor(worldName)
    if worldName == "Wasterland" then return "Toxic" end
    return worldName
end

local function getMissionsFolder(worldName)
    local ok, wm = pcall(function() return player.Data:FindFirstChild("WorldMissions") end)
    if not ok or not wm then return nil end
    local wf = wm:FindFirstChild(worldName) or wm:FindFirstChild(dataNameFor(worldName))
    return wf and wf:FindFirstChild("Missions")
end

local function isWorldComplete(worldName)
    local missions = getMissionsFolder(worldName)
    if not missions then return false end
    for _, m in ipairs(missions:GetChildren()) do
        local ok, val = pcall(function() return m.Value end)
        if ok and val == false then return false end
    end
    return true
end

local function isWorldUnlocked(worldName)
    local ok, val = pcall(function() return player.Data.Worlds[worldName].Value end)
    if ok and val ~= nil then return val == true end
    local ok2, val2 = pcall(function() return player.Data.Worlds[dataNameFor(worldName)].Value end)
    return ok2 and val2 == true
end

