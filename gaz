local function acquireCreature()
	-- Защита от повторного входа: если создание слота уже идёт,
	-- второй вызов не должен создать второй слот.
	if slotBusy then
		print("⏭️ Создание слота уже идёт, пропускаю повторный вызов")
		return
	end
	slotBusy = true

	print("🗑️ Удаляю все слоты...")
	for i = 1, 9 do
		pcall(function()
			ReplicatedStorage.Remotes.DeleteSlotRemote:InvokeServer("Slot" .. i, false)
		end)
		wait(0.3)
	end
	wait(1)

	-- Ждём, пока сервер реально снесёт слоты. Если создать новый,
	-- пока старый ещё жив, получается два слота.
	for i = 1, 12 do
		local filled = countFilledSlots()
		if filled == 0 then break end
		print("⏳ Слоты ещё не удалились (" .. filled .. "), жду... (" .. i .. "/12)")
		if i % 4 == 0 then
			for s = 1, 9 do
				pcall(function()
					ReplicatedStorage.Remotes.DeleteSlotRemote:InvokeServer("Slot" .. s, false)
				end)
				wait(0.2)
			end
		end
		wait(1)
	end

	-- Coins лежит в PlayerGui.PlayerDataGui.Data.Coins, но на части серверов
	-- в PlayerGui.Data.Coins. Проверяем оба места без WaitForChild, чтобы
	-- поток не завис навсегда на несуществующем пути.
	local coins = nil
	local pgui = player:WaitForChild("PlayerGui")

	local pdg = pgui:FindFirstChild("PlayerDataGui")
	if pdg then
		local d = pdg:FindFirstChild("Data")
		if d then coins = d:FindFirstChild("Coins") end
	end

	if not coins then
		local d = pgui:FindFirstChild("Data")
		if d then coins = d:FindFirstChild("Coins") end
	end

	print("💰 Кол-во монет: " .. (coins and coins.Value or 0))

	if coins and coins.Value >= 5 then
		print("💰 Монет >= 5, покупаю Eulopii...")
		pcall(function()
			PurchaseCreatureRemote:InvokeServer("TrialCreatures", "Eulopii", false)
		end)
	else
		print("💵 Монет < 5, использую UpdateFavoritedRemote...")
		pcall(function()
			local ohBoolean1 = true
			local ohBoolean2 = true
			ReplicatedStorage.Remotes.UpdateFavoritedRemote:FireServer(ohBoolean1, ohBoolean2)
		end)
		wait(1)
		print("🆕 Создаю слот Xeleviprex...")
		pcall(function()
			ReplicatedStorage.Remotes.CreateSlotRemote:InvokeServer("Xeleviprex")
		end)
	end
	wait(2)

	-- Если всё равно создалось больше одного слота — сносим лишние,
	-- оставляем только Slot1, иначе Play кликается не по тому слоту.
	local filled = countFilledSlots()
	if filled > 1 then
		print("🧹 Создалось слотов: " .. filled .. ", чищу лишние...")
		local data = findDataFolder()
		local slot1 = data and data:FindFirstChild("Slot1")
		local slot1Creature = slot1 and slot1:FindFirstChild("Creature")
		local slot1Filled = slot1Creature and slot1Creature.Value and slot1Creature.Value ~= ""

		if slot1Filled then
			for s = 2, 9 do
				local slot = data:FindFirstChild("Slot" .. s)
				local creature = slot and slot:FindFirstChild("Creature")
				if creature and creature.Value and creature.Value ~= "" then
					print("🧹 Удаляю лишний Slot" .. s)
					pcall(function()
						ReplicatedStorage.Remotes.DeleteSlotRemote:InvokeServer("Slot" .. s, false)
					end)
					wait(0.5)
				end
			end
			wait(1)
		else
			print("⚠️ Slot1 пуст, лишние не трогаю")
		end
	end

	print("🎮 Ищу SaveSelectionGui для входа...")
	local saveGui = nil
	for i = 1, 30 do
		saveGui = player:WaitForChild("PlayerGui"):FindFirstChild("SaveSelectionGui")
		if saveGui then break end
		wait(1)
	end

	if saveGui then
		print("✅ SaveSelectionGui найден, заходу...")
		wait(1)
		pcall(function()
			local container = saveGui:FindFirstChild("ContainerFrame")
			local allSlots = container and container:FindFirstChild("AllSlotsFrame")
			local pagesFrame = allSlots and allSlots:FindFirstChild("PagesFrame")
			local page1 = pagesFrame and pagesFrame:FindFirstChild("1")
			if page1 then
				for i = 1, 5 do
					clickButtonEnhanced(page1, "Page1_" .. i)
					wait(0.5)
				end
			end
		end)

		wait(2)

		-- Только FindFirstChild: прямое SlotsFrame["1"].InnerFrame... выбрасывает
		-- ошибку, если слот ещё не прогрузился, и поток молча умирает ровно
		-- перед кликом по Play.
		local playLabel = nil
		for tryCount = 1, 15 do
			pcall(function()
				local container = saveGui:FindFirstChild("ContainerFrame")
				if not container then return end
				local allSlots = container:FindFirstChild("AllSlotsFrame")
				if not allSlots then return end
				local slotsFrame = allSlots:FindFirstChild("SlotsFrame")
				if not slotsFrame then return end
				local slot1 = slotsFrame:FindFirstChild("1")
				if not slot1 then return end
				local inner = slot1:FindFirstChild("InnerFrame")
				if not inner then return end
				local creatureFrame = inner:FindFirstChild("CreatureFrame")
				if not creatureFrame then return end
				local buttonsFrame = creatureFrame:FindFirstChild("ButtonsFrame")
				if not buttonsFrame then return end
				local playButton = buttonsFrame:FindFirstChild("PlayButton")
				if not playButton then return end

				playLabel = playButton:FindFirstChild("UpperLabel") or playButton
			end)

			if playLabel then break end
			print("⏳ Жду прогрузки слота... (" .. tryCount .. "/15)")
			wait(1)
		end

		if not playLabel then
			print("❌ PlayButton не найден — слот не создался!")
			slotBusy = false
			return
		end

		for i = 1, 5 do
			clickButtonEnhanced(playLabel, "PlayButton_" .. i)
			wait(0.7)
			if not (saveGui.Parent and saveGui.Enabled) then break end
		end
		print("✅ Вход завершён!")
	end

	slotBusy = false
end

local function checkDeathDuringFarm()
	local playerGui = player.PlayerGui
	
	local deathGui = playerGui:FindFirstChild("DeathGui")
	if deathGui and deathGui.Enabled == true then
		-- Смерть уже обрабатывается — не запускаем второй круг
		-- удаления/создания слота.
		if deathInProgress then
			return true
		end
		deathInProgress = true
		farmAborted = true

		print("\n💀 ОБНАРУЖЕНА СМЕРТЬ ВО ВРЕМЯ ФАРМА!")

		print("⏳ Ожидание 20 секунд...")
		wait(20)

		print("🔥 Раздуваю Return и кликаю...")
		local clicks = 0
		while clicks < 8 do
			clicks = clicks + 1

			deathGui = playerGui:FindFirstChild("DeathGui")
			if not (deathGui and deathGui.Enabled) then break end

			local clicked = false
			pcall(function()
				local container = deathGui:FindFirstChild("ContainerFrame")
				local bottom = container and container:FindFirstChild("BottomFrame")
				local buttons = bottom and bottom:FindFirstChild("ButtonsFrame")
				local returnBtn = buttons and buttons:FindFirstChild("Return")
				local label = returnBtn and (returnBtn:FindFirstChild("UpperLabel") or returnBtn)
				if label then
					clickButtonEnhanced(label, "DeathReturn_" .. clicks)
					clicked = true
				end
			end)

			if not clicked then
				click()
			end
			wait(1)
		end

		-- Если DeathGui так и не закрылся, гасим принудительно.
		-- Иначе следующая же проверка снова увидит его включённым
		-- и запустит второе пересоздание слота.
		deathGui = playerGui:FindFirstChild("DeathGui")
		if deathGui and deathGui.Enabled then
			print("⚠️ DeathGui не закрылся кликами, гашу принудительно")
			pcall(function() deathGui.Enabled = false end)
		end

		print("✅ Выход из DeathGui")
		wait(10)

		print("🔄 Переделываю слот...")
		wait(2)

		-- pcall обязателен: если тут вылетит ошибка, deathInProgress
		-- останется true и смерти перестанут обрабатываться совсем.
		local ok, err = pcall(acquireCreature)
		if not ok then
			print("❌ Ошибка при пересоздании слота: " .. tostring(err))
			slotBusy = false
		end

		wait(5)
		currentRegionName = nil
		deathInProgress = false
		return true
	end
	
	return false
end

local function getPos(obj)
	if obj:IsA("Model") then
		if obj.PrimaryPart then return obj.PrimaryPart.Position end
		local part = obj:FindFirstChildWhichIsA("Part") or obj:FindFirstChildWhichIsA("MeshPart")
		if part then return part.Position end
	elseif obj:IsA("BasePart") then
		return obj.Position
	end
	return Vector3.new()
end

local function findNearestGrass()
	local char = player.Character
	if not char then return nil end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local p = root.Position
	local best, bestDist = nil, math.huge
	for _, f in ipairs(foodFolder:GetChildren()) do
		if f.Name:lower():find("grass") or f.Name:lower():find("decor") then
			local pos = getPos(f)
			local d = (pos - p).Magnitude
			if d < bestDist then
				bestDist = d
				best = f
			end
		end
	end
	return best
end

local function teleportTo(pos)
	local char = player.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		char.HumanoidRootPart.CFrame = CFrame.new(pos)
	end
end

local function changeRegion(r)
	currentRegionName = r
	ChangeRegionRemote:FireServer(r)
	wait(0.5)
end

local function findNPCForAttack()
	local rootsNPC = npcsFolder:FindFirstChild("Roots")
	if rootsNPC then
		local rootPart = rootsNPC:FindFirstChild("RootPart")
		if rootPart then
			return rootPart
		end
	end
	
	for _, npc in ipairs(npcsFolder:GetChildren()) do
		local rp = npc:FindFirstChild("RootPart") or npc:FindFirstChild("HumanoidRootPart")
		if rp then
			return rp
		end
	end
	
	return nil
end

local function useFoodAndWater()
	local nearestGrass = findNearestGrass()
	
	if nearestGrass then
		print("🍃 Найден Grass (еда): " .. nearestGrass.Name)
		
		local grassPos = getPos(nearestGrass)
		
		teleportTo(grassPos + Vector3.new(0, 5, 0))
		print("📍 Телепортировались к Grass (еде)")
		
		wait(1)
		
		if currentRegionName then
			print("🔄 Меняем регион после телепортации к Grass: " .. currentRegionName)
			changeRegion(currentRegionName)
		end
		
		local foodArgs = { nearestGrass }
		FoodRemote:FireServer(unpack(foodArgs))
		print("🍎 Использована Grass (еда): " .. nearestGrass.Name)
	else
		local foodFolder = interactions.Food
		local foodChildren = foodFolder:GetChildren()
		
		if #foodChildren > 0 then
			local foodItem = foodChildren[1]
			
			if foodItem then
				local foodArgs = { foodItem }
				FoodRemote:FireServer(unpack(foodArgs))
				print("🍎 Использована еда: " .. foodItem.Name)
			end
		end
	end
	
	local lake = interactions.Lakes:FindFirstChild("Lake")
	if lake then
		local drinkArgs = { lake }
		DrinkRemote:FireServer(unpack(drinkArgs))
		print("💧 Использована вода")
	else
		local waterSource = interactions.Lakes:FindFirstChildOfClass("Part")
		if waterSource then
			local drinkArgs = { waterSource }
			DrinkRemote:FireServer(unpack(drinkArgs))
		end
	end
end

local function completeSniffMission(regionName)
	print("🔄 Выполняем Sniff в регионе: " .. regionName)
	
	changeRegion(regionName)
	
	local data = player:WaitForChild("PlayerGui"):FindFirstChild("Data")
	local regionMissions = data:FindFirstChild("Missions"):FindFirstChild("RegionMissions")
	
	local missionCompleted = false
	local attempts = 0
	
	while not missionCompleted and attempts < 25 do
		attempts = attempts + 1
		
		if attempts % 5 == 0 then
			useFoodAndWater()
		end
		
		if checkDeathDuringFarm() then
			return false
		end
		
		local missionArgs = { 1 }
		SetMissionRemote:FireServer(unpack(missionArgs))
		
		local regionFolder = regionMissions:FindFirstChild(regionName)
		if regionFolder then
			local sniffMission = regionFolder:FindFirstChild("Sniff")
			if sniffMission and sniffMission.Value then
				missionCompleted = true
				print("✅ Sniff выполнена в регионе " .. regionName)
			else
				print("⏳ Sniff... (" .. attempts .. "/25)")
			end
		end
		
		if not missionCompleted then
			wait(0.8)
		end
	end
	
	return missionCompleted
end

