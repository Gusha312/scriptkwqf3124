local function completeTimePlayedMission(regionName)
	print("🔄 Выполняем TimePlayed в регионе: " .. regionName)
	print("⏰ Ожидаем...")
	
	changeRegion(regionName)
	
	local data = player:WaitForChild("PlayerGui"):FindFirstChild("Data")
	local regionMissions = data:FindFirstChild("Missions"):FindFirstChild("RegionMissions")
	
	local missionCompleted = false
	local checkCount = 0
	
	while not missionCompleted do
		checkCount = checkCount + 1
		
		if checkCount % 3 == 0 then
			useFoodAndWater()
		end
		
		if checkDeathDuringFarm() then
			return false
		end
		
		local regionFolder = regionMissions:FindFirstChild(regionName)
		if regionFolder then
			local timeMission = regionFolder:FindFirstChild("TimePlayed")
			if timeMission and timeMission.Value then
				missionCompleted = true
				print("✅ TimePlayed выполнена в регионе " .. regionName)
				break
			else
				if checkCount % 5 == 0 then
					print("⏳ TimePlayed... (" .. checkCount .. " проверок)")
				end
			end
		end
		
		wait(5)
	end
	
	return missionCompleted
end

local ignoredRegions = {
	["Shadow Isle"] = true,
	["Shadow Isles"] = true,
	["Basalt Cave"] = true
}

local function calculatePoints()
	local activeSlot = findActiveSlot()
	if not activeSlot then return 0 end
	
	local data = player:WaitForChild("PlayerGui"):WaitForChild("Data")
	local slot = data:FindFirstChild(activeSlot)
	if not slot then return 0 end
	
	local deathStats = slot:FindFirstChild("DeathStats")
	if not deathStats then return 0 end

	local timePlayed = deathStats:FindFirstChild("TimePlayed")
	local missionsCompleted = deathStats:FindFirstChild("MissionsCompleted")
	local disastersSurvived = deathStats:FindFirstChild("DisastersSurvived")
	local teen = deathStats:FindFirstChild("GrowCreatureTeen")
	local adult = deathStats:FindFirstChild("GrowCreatureAdult")

	local points = 0
	if timePlayed then
		points = points + math.floor(timePlayed.Value / 240)
	end
	if missionsCompleted then
		points = points + missionsCompleted.Value * 4
	end
	if disastersSurvived then
		points = points + disastersSurvived.Value * 6
	end
	if teen then
		points = points + teen.Value * 5
	end
	if adult then
		points = points + adult.Value * 10
	end
	return points
end

local lastPointsPrint = 0

local function checkPointsAndDie()
	local points = calculatePoints()

	if tick() - lastPointsPrint >= 60 then
		lastPointsPrint = tick()
		print("📊 Текущие очки: " .. points)
	end

	if points >= 751 then
		print("💀 ОЧКИ >= 751! Самоубийство через OutOfBounds!")
		pcall(function()
			OutOfBoundsSelfDamage:FireServer(1000000)
			wait(0.2)
			OutOfBoundsSelfDamage:FireServer(1000000)
			wait(0.2)
			OutOfBoundsSelfDamage:FireServer(1000000)
		end)
		return true
	end
	return false
end

local function getUncompletedMissions()
	local data = player:WaitForChild("PlayerGui"):FindFirstChild("Data")
	if not data then return {} end
	local missions = data:FindFirstChild("Missions")
	if not missions then return {} end
	local regionMissions = missions:FindFirstChild("RegionMissions")
	if not regionMissions then return {} end
	
	local list = {}
	for _, r in pairs(regionMissions:GetChildren()) do
		if ignoredRegions[r.Name] then continue end
		for _, m in pairs(r:GetChildren()) do
			if m:IsA("BoolValue") and not m.Value and m.Name ~= "ShoomPilesCollected" then
				table.insert(list, { region = r.Name, name = m.Name })
			end
		end
	end
	return list
end

