local function completeAttackOrHealMission(regionName)
	print("🔄 Выполняем AttackOrHealCreatureOrNPC в регионе: " .. regionName)
	
	changeRegion(regionName)
	
	local npcSpawns = npcSpawnsFolder:GetChildren()
	if #npcSpawns > 0 then
		local randomSpawn = npcSpawns[math.random(1, #npcSpawns)]
		if randomSpawn then
			local spawnPos = getPos(randomSpawn)
			local spawnPosition = spawnPos + Vector3.new(0, 30, 0)
			teleportTo(spawnPosition)
			wait(1)
			changeRegion(regionName)
		end
	end
	
	local data = player:WaitForChild("PlayerGui"):FindFirstChild("Data")
	local regionMissions = data:FindFirstChild("Missions"):FindFirstChild("RegionMissions")
	
	local missionCompleted = false
	local attempts = 0
	
	while not missionCompleted and attempts < 60 do
		attempts = attempts + 1
		
		if attempts % 15 == 0 then
			useFoodAndWater()
		end
		
		if checkDeathDuringFarm() then
			return false
		end
		
		local targetNPC = findNPCForAttack()
		if targetNPC then
			local attackArgs = { { targetNPC } }
			AttackRemote:FireServer(unpack(attackArgs))
		end
		
		local regionFolder = regionMissions:FindFirstChild(regionName)
		if regionFolder then
			local attackMission = regionFolder:FindFirstChild("AttackOrHealCreatureOrNPC")
			if attackMission and attackMission.Value then
				missionCompleted = true
				print("✅ AttackOrHealCreatureOrNPC выполнена в регионе " .. regionName)
				break
			end
		end
		
		if not missionCompleted then
			wait(0.3)
		end
