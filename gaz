-- Data лежит либо в PlayerGui.Data, либо в PlayerGui.PlayerDataGui.Data.
-- Ищем без WaitForChild, чтобы поток не завис на несуществующем пути.
local function findDataFolder()
	local pgui = player:FindFirstChild("PlayerGui")
	if not pgui then return nil end

	local pdg = pgui:FindFirstChild("PlayerDataGui")
	if pdg then
		local d = pdg:FindFirstChild("Data")
		if d and d:FindFirstChild("Slot1") then return d end
	end

	local direct = pgui:FindFirstChild("Data")
	if direct and direct:FindFirstChild("Slot1") then return direct end

	if pdg and pdg:FindFirstChild("Data") then return pdg.Data end
	return direct
end

-- Сколько слотов реально занято существом
local function countFilledSlots()
	local data = findDataFolder()
	if not data then return 0 end

	local count = 0
	for i = 1, 9 do
		local slot = data:FindFirstChild("Slot" .. i)
		if slot then
			local creature = slot:FindFirstChild("Creature")
			if creature and creature.Value and creature.Value ~= "" then
				count = count + 1
			end
		end
	end
	return count
end

