-- Первый цикл (forage)
task.spawn(function()
    wait(20) -- начальная задержка, как в оригинале
    while true do
        local randomValue = math.random(1, 50)
        local args = { randomValue }
        local success, result = pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("CompleteForageableRemote"):InvokeServer(unpack(args))
        end)
        if not success then
            warn("Ошибка при вызове InvokeServer (forage): ", result)
        else
            print("Отправлено число: " .. randomValue)
        end
        local waitTime = math.random(6, 18)
        wait(waitTime)
    end
end)

-- Второй цикл (покупка предметов)
task.spawn(function()
    -- Список всех предметов (включая добавленные)
    local items = {
        "Eigion Warden",
        "Geortharoc"
    }

    while true do
        for _, itemName in ipairs(items) do
            local args = { itemName, 1 }
            local success, result = pcall(function()
                game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("PurchaseEventItemRemote"):InvokeServer(unpack(args))
            end)
            if not success then
                warn("Ошибка при покупке " .. itemName .. ": ", result)
            else
                print("Куплен предмет: " .. itemName)
            end
            wait(1) -- задержка между покупками, как в оригинале
        end
        -- Пауза после полного прохода по всем предметам
        local waitTime = math.random(6, 18)
        print("Цикл покупок завершён, пауза " .. waitTime .. " сек.")
        wait(waitTime)
    end
end)
