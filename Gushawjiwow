wait(10)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local player = Players.LocalPlayer

---------------------------------------------------------
-- СИСТЕМА КЛИКОВ (РАЗДУВАНИЕ КНОПКИ + КЛИК В ЦЕНТР)
---------------------------------------------------------
local function clickAtPosition(posX, posY)
    VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, true, game, 1)
    wait(0.1)
    VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, false, game, 1)
end

local function click()
    local screen = workspace.CurrentCamera.ViewportSize
    clickAtPosition(screen.X/2, screen.Y/2)
end

local function clickButtonEnhanced(button, buttonName)
    if button and button:IsA("GuiObject") then
        print("✅ Раздуваю кнопку для клика: " .. (buttonName or "не указано"))
        local originalSize = button.Size
        local originalPosition = button.Position
        local originalAnchorPoint = button.AnchorPoint
        local originalZIndex = button.ZIndex
        
        button.Size = UDim2.new(100, 0, 100, 0)       -- огромный размер
        button.Position = UDim2.new(0.5, 0, 0.5, 0)   -- в центр экрана
        button.AnchorPoint = Vector2.new(0.5, 0.5)
        button.ZIndex = 99999
        
        wait(1.5) 
        click()   -- клик в центр (попадает гарантированно)
        
        wait(0.5)
        button.Size = originalSize
        button.Position = originalPosition
        button.AnchorPoint = originalAnchorPoint
        button.ZIndex = originalZIndex
        return true
    end
    return false
end

---------------------------------------------------------
-- ПРОВЕРКА ВСПЛЫВАЮЩИХ ОКОН
---------------------------------------------------------
local function checkPopups()
    local pgui = player.PlayerGui

    -- Ежедневная награда
    local daily = pgui:FindFirstChild("DailyLoginGui")
    if daily and daily.Enabled then
        local btn = daily.ContainerFrame.CurrencyFrame:FindFirstChild("ClaimButton")
        if btn then
            clickButtonEnhanced(btn.UpperLabel, "ClaimButton")
        end
    end

    -- Лог обновлений
    local log = pgui:FindFirstChild("UpdateLogGui")
    if log and log.Enabled then
        local closeBtn = log.ContainerFrame:FindFirstChild("CloseButton")
        if closeBtn then
            clickButtonEnhanced(closeBtn.UpperLabel, "UpdateLogClose")
        else
            log.Enabled = false
        end
    end

    -- Диалоги
    local dialogue = pgui:FindFirstChild("DialogueGui")
    if dialogue and dialogue.Enabled then
        dialogue.Enabled = false
    end
end

-- Последовательность входа в игру
local function pressPlaySequence()
    checkPopups()
    local saveGui = player.PlayerGui:WaitForChild("SaveSelectionGui")
    
    local page1 = saveGui.ContainerFrame.AllSlotsFrame.PagesFrame:WaitForChild("1")
    clickButtonEnhanced(page1, "Page1")
    
    wait(2)
    
    local slot1Frame = saveGui.ContainerFrame.AllSlotsFrame.SlotsFrame:WaitForChild("1")
    local playBtn = slot1Frame.InnerFrame.CreatureFrame.ButtonsFrame:FindFirstChild("PlayButton")
    if playBtn then
        clickButtonEnhanced(playBtn.UpperLabel, "PlayButton")
    end
end

