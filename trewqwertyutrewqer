local blacklistSet = {}

local function loadBlacklist()
    local list = httpGet(SERVER_URL .. "/api/blacklist")
    if list and type(list) == "table" then
        blacklistSet = {}
        for _, n in ipairs(list) do
            blacklistSet[tostring(n):lower()] = true
        end
        print("[blacklist] загружено:", #list, "элементов")
    end
end

local function isBlacklisted(name)
    if not name then return false end
    return blacklistSet[tostring(name):lower()] == true
end

loadBlacklist()
