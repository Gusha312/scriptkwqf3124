local function getStallAnchor()
    local interactable = Workspace:FindFirstChild("Interactable")
    if not interactable then return nil end
    local stalls = interactable:FindFirstChild("MarketStalls")
    if not stalls then return nil end
    return stalls:FindFirstChild("AnchorPart")
end

-- Получить объект MarketStall (содержит Listing1-Listing4)
local function getMarketStall()
    local anchor = getStallAnchor()
    if not anchor then return nil end
    return anchor:FindFirstChild("MarketStall")
end

-- Занять стойку
local function claimStall()
    local anchor = getStallAnchor()
    if not anchor then return false end
    -- Проверяем, занята ли уже (есть ли объект Barrel)
    local barrel = anchor:FindFirstChild("MarketStall"):FindFirstChild("Barrel")
    if barrel and barrel:FindFirstChild("NameTag") and barrel.NameTag.Value == myName then
        return true -- уже наша
    end
    -- Пытаемся занять
    local success, err = pcall(function()
        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ClaimStall"):FireServer(anchor)
    end)
    if not success then
        warn("[Stall] ClaimStall error:", err)
        return false
    end
    -- Ждём, пока стойка не станет нашей
    for _ = 1, 20 do
        task.wait(0.5)
        local b = anchor:FindFirstChild("MarketStall"):FindFirstChild("Barrel")
        if b and b:FindFirstChild("NameTag") and b.NameTag.Value == myName then
            return true
        end
    end
    return false
end

-- Получить информацию о листинге из стойки (для любого игрока)
-- Возвращает таблицу { ItemName, Price, Amount, Owner } или nil, если пусто
local function getStallListing(listingIndex)
    local marketStall = getMarketStall()
    if not marketStall then return nil end
    local listing = marketStall:FindFirstChild("Listing" .. listingIndex)
    if not listing then return nil end
    local itemName = listing:FindFirstChild("ItemName")
    local price = listing:FindFirstChild("Price")
    local amount = listing:FindFirstChild("Amount")
    local owner = listing:FindFirstChild("Owner") -- или NameTag
    if not itemName or not price or not amount then return nil end
    return {
        ItemName = itemName.Value,
        Price = price.Value,
        Amount = amount.Value,
        Owner = owner and owner.Value or ""
    }
end

-- Выставить предмет на продажу (возвращает номер листинга 1-4 или nil)
local function listItem(itemName, amount)
    local anchor = getStallAnchor()
    if not anchor then return nil end
    -- Проверяем, что стойка наша (есть Barrel с нашим именем)
    local barrel = anchor:FindFirstChild("MarketStall"):FindFirstChild("Barrel")
    if not barrel or not barrel:FindFirstChild("NameTag") or barrel.NameTag.Value ~= myName then
        warn("[Stall] Стойка не наша")
        return nil
    end
    -- Ищем свободный слот (Listing с пустым ItemName)
    for i = 1, 4 do
        local info = getStallListing(i)
        if info and (info.ItemName == "" or info.ItemName == nil) then
            -- Выставляем
            local success, err = pcall(function()
                ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ListPurchaseItem"):FireServer(itemName, amount, 1)
            end)
            if success then
                -- Ждём появления листинга
                task.wait(1)
                local newInfo = getStallListing(i)
                if newInfo and newInfo.ItemName == itemName and newInfo.Price == 1 and newInfo.Owner == myName then
                    return i
                end
            else
                warn("[Stall] ListPurchaseItem error:", err)
            end
            return nil
        end
    end
    return nil -- все слоты заняты
end

-- Снять листинг по индексу
local function removeItem(listingIndex)
    local success, err = pcall(function()
        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("RemoveStallItem"):FireServer(listingIndex)
    end)
    if not success then
        warn("[Stall] RemoveStallItem error:", err)
        return false
    end
    return true
end

-- Купить предмет со стойки (по индексу листинга)
-- anchorPart — AnchorPart стойки (для твинка)
-- listingIndex — номер листинга (1-4)
-- amount — сколько купить (можно передать всё количество)
local function buyItem(anchorPart, listingIndex, amount)
    -- Получаем информацию о листинге, чтобы взять ItemName и Price
    local marketStall = anchorPart:FindFirstChild("MarketStall")
    if not marketStall then return false end
    local listing = marketStall:FindFirstChild("Listing" .. listingIndex)
    if not listing then return false end
    local itemName = listing:FindFirstChild("ItemName")
    local price = listing:FindFirstChild("Price")
    if not itemName or not price then return false end
    local success, err = pcall(function()
        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BuyStallItem"):FireServer(
            anchorPart,
            itemName.Value,
            price.Value,
            amount,
            listingIndex
        )
    end)
    if not success then
        warn("[Stall] BuyStallItem error:", err)
        return false
    end
    return true
end

