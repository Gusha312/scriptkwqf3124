--[[ НАСТРОЙКИ ]]
local SERVER_URL = "http://109.234.34.60:8001"  -- укажите свой
local TOKEN_NAMES = {
    "BloodMoonSummonToken",
    "CreatureReviveToken",
    "EarthquakeSummonToken",
    "FullGrowToken",
    "StormSummonToken"
}
local UPDATE_INTERVAL = 30 -- секунды
--[[ ========== ]]

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer
local requestFunc = syn and syn.request or http_request or request

local function httpPost(url, data)
    if not requestFunc then return nil end
    local ok, res = pcall(function()
        return requestFunc({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(data)
        })
    end)
    return ok and res or nil
end

task.wait(10) -- ждём загрузки игровых данных

while true do
    local data = { name = player.Name }
    local pg = player:FindFirstChild("PlayerGui")
    if pg then
        local dataFolder = pg:FindFirstChild("Data")
        if dataFolder then
            local items = dataFolder:FindFirstChild("Items")
            if items then
                for _, tokenName in ipairs(TOKEN_NAMES) do
                    local token = items:FindFirstChild(tokenName)
                    local value = 0
                    if token and (token:IsA("NumberValue") or token:IsA("IntValue")) then
                        value = token.Value
                    end
                    data[tokenName] = value
                end
            end
        end
    end
    pcall(function()
        httpPost(SERVER_URL .. "/api/tokenstats", data)
    end)
    print("Отправлена статистика токенов:", data)
    task.wait(UPDATE_INTERVAL)
end
