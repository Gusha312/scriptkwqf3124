--[[ НАСТРОЙКИ ]]
local SERVER_URL = "http://87.199.204.174:8001"   -- адрес вашего сервера
local TOKEN_NAMES = {
    "BloodMoonSummonToken",
    "CreatureReviveToken",
    "EarthquakeSummonToken",
    "FullGrowToken",
    "StormSummonToken"
}
local UPDATE_INTERVAL = 30  -- как часто отправлять (в секундах)
--[[ ========== ]]

local Players      = game:GetService("Players")
local HttpService  = game:GetService("HttpService")
local player       = Players.LocalPlayer
local requestFunc  = syn and syn.request or http_request or request

local function httpPost(url, data)
    if not requestFunc then return nil end
    local ok, res = pcall(function()
        return requestFunc({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(data)
        })
    end)
    return ok and res or nil
end

-- Ждём загрузки данных игрока (10 секунд обычно достаточно)
task.wait(10)

while true do
    local dataToSend = { name = player.Name }

    -- Ищем папку с данными
    local pg = player:FindFirstChild("PlayerGui")
    if pg then
        local dataFolder = pg:FindFirstChild("Data")
        if dataFolder then
            local items = dataFolder:FindFirstChild("Items")
            if items then
                -- Для каждого токена из списка берём его значение
                for _, tokenName in ipairs(TOKEN_NAMES) do
                    local token = items:FindFirstChild(tokenName)
                    local value = 0
                    if token and (token:IsA("NumberValue") or token:IsA("IntValue")) then
                        value = token.Value
                    end
                    dataToSend[tokenName] = value
                end
            end
        end
    end

    -- Отправляем на сервер
    pcall(function()
        httpPost(SERVER_URL .. "/api/tokenstats", dataToSend)
    end)

    print("Отправлена статистика:", dataToSend)
    task.wait(UPDATE_INTERVAL)
end
