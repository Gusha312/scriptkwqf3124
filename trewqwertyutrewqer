-- ═══════════════════════════════════════════════════════════════
-- Скрипт только для сбора статистики (без трейдов, телепортов)
-- ═══════════════════════════════════════════════════════════════

local SERVER_URL = "http://109.234.34.60:3000"  -- адрес вашего сервера

local PlaceId = game.PlaceId
-- Можно оставить проверку на нужное место (опционально)
local validPlaces = { [5233782396] = true }      -- только мир сбора статистики
if not validPlaces[PlaceId] then return end

task.wait(5)  -- небольшая задержка перед стартом

local Players           = game:GetService("Players")
local HttpService       = game:GetService("HttpService")
local player            = Players.LocalPlayer
local myName            = player.Name

-- Выбор функции запроса (поддержка разных исполнителей)
local requestFunc = syn and syn.request or http_request or request

-- Вспомогательная функция POST
local function httpPost(url, data)
    if not requestFunc then return nil end
    local ok, res = pcall(function()
        return requestFunc({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(data)
        })
    end)
    return ok and res or nil
end

-- Вспомогательная функция GET (используется для получения списков предметов)
local function httpGet(url)
    if not requestFunc then return nil end
    local ok, res = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)
    if ok and res and res.Body then
        local ok2, d = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if ok2 then return d end
    end
    return nil
end

-- Загружаем с сервера названия отслеживаемых предметов
local tokenNames = {}
local tokensRes = httpGet(SERVER_URL .. "/api/tokens")
if tokensRes and type(tokensRes) == "table" then tokenNames = tokensRes end

local creatureNames = {}
local creaturesRes = httpGet(SERVER_URL .. "/api/creatures")
if creaturesRes and type(creaturesRes) == "table" then creatureNames = creaturesRes end

local plushieNames = {}
local plushiesRes = httpGet(SERVER_URL .. "/api/plushies")
if plushiesRes and type(plushiesRes) == "table" then plushieNames = plushiesRes end

local paletteNames = {}
local palettesRes = httpGet(SERVER_URL .. "/api/palettes")
if palettesRes and type(palettesRes) == "table" then paletteNames = palettesRes end

-- Основной цикл сбора статистики (отправка каждые 5 секунд)
task.spawn(function()
    while true do
        local dataToSend = { name = myName }

        local pg = player:FindFirstChild("PlayerGui")
        if pg then
            local data = pg:FindFirstChild("Data")
            if data then
                -- Токены (Items)
                local items = data:FindFirstChild("Items")
                if items then
                    for _, n in ipairs(tokenNames) do
                        local t = items:FindFirstChild(n)
                        dataToSend[n] = (t and (t:IsA("NumberValue") or t:IsA("IntValue"))) and t.Value or 0
                    end
                end

                -- Существа (Unlocks)
                local unlocks = data:FindFirstChild("Unlocks")
                if unlocks then
                    for _, cName in ipairs(creatureNames) do
                        local c = unlocks:FindFirstChild(cName)
                        dataToSend[cName] = (c and (c:IsA("NumberValue") or c:IsA("IntValue"))) and c.Value or 0
                    end
                end

                -- Плюши (Plushies)
                local plushiesFolder = data:FindFirstChild("Plushies")
                if plushiesFolder then
                    for _, pName in ipairs(plushieNames) do
                        local c = plushiesFolder:FindFirstChild(pName)
                        local val = c and c.Value or 0
                        if type(val) == "boolean" then val = val and 1 or 0 end
                        dataToSend["PLUSHIE_" .. pName] = math.floor(tonumber(val) or 0)
                    end
                end

                -- Палитры (SpecialPalettes)
                local palettesFolder = data:FindFirstChild("SpecialPalettes")
                if palettesFolder then
                    for _, pName in ipairs(paletteNames) do
                        local c = palettesFolder:FindFirstChild(pName)
                        local val = c and c.Value or 0
                        if type(val) == "boolean" then val = val and 1 or 0 end
                        dataToSend["PALETTE_" .. pName] = math.floor(tonumber(val) or 0)
                    end
                end
            end
        end

        -- Отправка данных на сервер
        pcall(function()
            requestFunc({
                Url = SERVER_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(dataToSend)
            })
        end)

        task.wait(5)   -- интервал отправки
    end
end)

-- Скрипт завершён – статистика собирается в фоне.
