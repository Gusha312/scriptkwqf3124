local function getMainSnapshot()
    local result = {}
    local dataFolder = player:FindFirstChild("Data")
    if not dataFolder then return result end
    local tokens = httpGet(SERVER_URL .. "/api/tokens") or {}
    local creatures = httpGet(SERVER_URL .. "/api/creatures") or {}
    local plushies = httpGet(SERVER_URL .. "/api/plushies") or {}
    local palettes = httpGet(SERVER_URL .. "/api/palettes") or {}

    local items = dataFolder:FindFirstChild("Items")
    local unlocks = dataFolder:FindFirstChild("Unlocks")
    local plushFolder = dataFolder:FindFirstChild("Plushies")
    local palFolder = dataFolder:FindFirstChild("SpecialPalettes")

    for _, name in ipairs(tokens) do
        local val = items and items:FindFirstChild(name) and items[name].Value or 0
        result[name] = val
    end
    for _, name in ipairs(creatures) do
        local val = unlocks and unlocks:FindFirstChild(name) and unlocks[name].Value or 0
        if type(val) == "boolean" then val = val and 1 or 0 end
        result[name] = tonumber(val) or 0
    end
    for _, name in ipairs(plushies) do
        local val = plushFolder and plushFolder:FindFirstChild(name) and plushFolder[name].Value or 0
        if type(val) == "boolean" then val = val and 1 or 0 end
        result["PLUSHIE_" .. name] = tonumber(val) or 0
    end
    for _, name in ipairs(palettes) do
        local val = palFolder and palFolder:FindFirstChild(name) and palFolder[name].Value or 0
        if type(val) == "boolean" then val = val and 1 or 0 end
        result["PALETTE_" .. name] = tonumber(val) or 0
    end
    return result
end

