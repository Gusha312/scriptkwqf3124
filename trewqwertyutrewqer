-- ============================================================
--  КЛИЕНТСКИЙ СКРИПТ ДЛЯ СБОРА СТАТИСТИКИ (ROBLOX)
--  Отправляет POST-запросы на ваш сервер каждые 5 секунд.
-- ============================================================

local SERVER_URL = "http://109.234.34.60:3000"   -- адрес вашего сервера

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer

-- Выбираем функцию запроса (поддержка разных исполнителей)
local requestFunc = syn and syn.request or http_request or request
if not requestFunc then
    warn("Не найдена функция для HTTP-запросов! Скрипт не работает.")
    return
end

-- Вспомогательная функция POST
local function httpPost(url, data)
    local ok, res = pcall(function()
        return requestFunc({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(data)
        })
    end)
    return ok and res or nil
end

-- Функция для безопасного получения числового значения из объекта
local function getNumericValue(obj)
    if not obj then return 0 end
    if obj:IsA("BoolValue") then
        return obj.Value and 1 or 0
    elseif obj:IsA("NumberValue") or obj:IsA("IntValue") then
        return obj.Value
    else
        return 0
    end
end

-- Основной цикл сбора и отправки
task.spawn(function()
    while true do
        local dataToSend = { name = player.Name }

        local pg = player:FindFirstChild("PlayerGui")
        if pg then
            local data = pg:FindFirstChild("Data")
            if data then
                -- === 1. Основные значения Coins и TimePoints ===
                local coins = data:FindFirstChild("Coins")
                if coins then dataToSend.Coins = getNumericValue(coins) end

                local timePoints = data:FindFirstChild("TimePoints")
                if timePoints then dataToSend.TimePoints = getNumericValue(timePoints) end

                -- === 2. Токены (папка Items) ===
                local items = data:FindFirstChild("Items")
                if items then
                    for _, child in ipairs(items:GetChildren()) do
                        local val = getNumericValue(child)
                        if val > 0 then
                            dataToSend["TOKEN_" .. child.Name] = val
                        end
                    end
                end

                -- === 3. Существа (папка Unlocks) ===
                local unlocks = data:FindFirstChild("Unlocks")
                if unlocks then
                    for _, child in ipairs(unlocks:GetChildren()) do
                        local val = getNumericValue(child)
                        if val > 0 then
                            dataToSend[child.Name] = val   -- без префикса (как есть)
                        end
                    end
                end

                -- === 4. Плюши (папка Plushies) ===
                local plushies = data:FindFirstChild("Plushies")
                if plushies then
                    for _, child in ipairs(plushies:GetChildren()) do
                        local val = getNumericValue(child)
                        if val > 0 then
                            dataToSend["PLUSHIE_" .. child.Name] = val
                        end
                    end
                end

                -- === 5. Палитры (проверяем обе возможные папки) ===
                local palettes = data:FindFirstChild("SpecialPalettes") or data:FindFirstChild("MaterialPalettes")
                if palettes then
                    for _, child in ipairs(palettes:GetChildren()) do
                        local val = getNumericValue(child)
                        if val > 0 then
                            dataToSend["PALETTE_" .. child.Name] = val
                        end
                    end
                end
            end
        end

        -- Отправляем данные на сервер
        httpPost(SERVER_URL, dataToSend)
        task.wait(5)   -- интервал отправки (5 секунд)
    end
end)

print("Скрипт сбора статистики запущен. Отправка каждые 5 секунд.")
