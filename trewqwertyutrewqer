-- =========================
--  ПРЕФИКСЫ ПАПОК
-- =========================
local function getPrefix(folderName)
    if folderName == "Items" then
        return "TOKEN_"
    elseif folderName == "Plushies" then
        return "PLUSHIE_"
    elseif folderName == "SpecialPalettes" then
        return "PALETTE_"
    end
    return ""
end

local function readValue(child)
    local v = child.Value
    if type(v) == "boolean" then
        if v then
            return 1
        end
        return 0
    end
    v = tonumber(v)
    if not v then
        return 0
    end
    return math.floor(v)
end

