warn("[cycle] start")

local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TS = game:GetService("TeleportService")

local FRIEND_NAME = "EzraVenom2011YT"
local ITEM_NAME = "Saukuryn"
local MAIN_PLACE = 5233782396
local TRADE_PLACE = 14119723130

local function LP()
    return Players.LocalPlayer
end

-- значение PlayerData -> Unlocks -> Saukuryn (0 или 1)
-- путь одинаковый в главном мире и в трейд-реалме
local function speciesSaukuryn()
    local lp = LP()
    if not lp or not lp.PlayerGui then return nil end
    local pdg = lp.PlayerGui:FindFirstChild("PlayerDataGui")
    local data = pdg and pdg:FindFirstChild("Data")
    if not data then return nil end

    local unlocks = data:FindFirstChild("Unlocks")
    if unlocks then
        local sau = unlocks:FindFirstChild("Saukuryn")
        if sau and sau:IsA("ValueBase") then
            return sau.Value
        end
    end
    -- запасные варианты
    for _, fn in ipairs({ "species", "Species", "Creatures", "ItemFolders" }) do
        local folder = data:FindFirstChild(fn)
        if folder then
            local sau = folder:FindFirstChild("Saukuryn")
            if sau and sau:IsA("ValueBase") then
                return sau.Value
            end
        end
    end
    return nil
end

local function waitReady()
    local waited = 0
    while true do
        local lp = LP()
        if RS:FindFirstChild("Remotes")
            and RS:FindFirstChild("_replicationFolder")
            and lp
            and lp.PlayerGui
            and lp.PlayerGui:FindFirstChild("PlayerDataGui") then
            warn("[cycle] game loaded (waited " .. tostring(waited) .. "s)")
            return true
        end
        task.wait(1)
        waited = waited + 1
        if waited % 30 == 0 then
            warn("[cycle] waiting for game load... " .. tostring(waited) .. "s")
        end
    end
end

-- получить Saukuryn (SetTutorialStageRemote), вернуть true если species=1
local function getSaukuryn()
    local st = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("SetTutorialStageRemote")
    if not st then warn("[cycle] SetTutorialStageRemote missing"); return false end
    pcall(function() st:InvokeServer("CreatureEditor", ITEM_NAME) end)
    task.wait(1.5)
    local v = speciesSaukuryn()
    warn("[cycle] after get, species." .. ITEM_NAME .. " = " .. tostring(v))
    return v == 1
end

local function friendRoot()
    local friend = Players:FindFirstChild(FRIEND_NAME)
    if not friend then return nil end
    local inter = workspace:FindFirstChild("Interactable")
    local ms = inter and inter:FindFirstChild("MarketStalls")
    if not ms then return nil end
    for _, part in ipairs(ms:GetChildren()) do
        if tostring(part:GetAttribute("Owner")) == tostring(friend.UserId) then
            return part
        end
    end
    return nil
end

local function friendOrder()
    local friend = Players:FindFirstChild(FRIEND_NAME)
    if not friend then return nil end
    local ms = friend:FindFirstChild("PublicData") and friend.PublicData:FindFirstChild("MarketStalls")
    if not ms then return nil end
    for i = 1, 30 do
        local l = ms:FindFirstChild("Listing" .. i)
        if l and l:FindFirstChild("ItemName") and l.ItemName.Value == ITEM_NAME
            and l:FindFirstChild("ListingType") and l.ListingType.Value == "Buying"
            and l:FindFirstChild("Amount") and l.Amount.Value > 0
            and l:FindFirstChild("Price") then
            return { index = i, price = l.Price.Value }
        end
    end
    return nil
end

local function friendL3Amount(index)
    local friend = Players:FindFirstChild(FRIEND_NAME)
    if not friend then return nil end
    local ms = friend:FindFirstChild("PublicData") and friend.PublicData:FindFirstChild("MarketStalls")
    if not ms then return nil end
    local l = ms:FindFirstChild("Listing" .. index)
    if not l or not l:FindFirstChild("Amount") then return nil end
    return l.Amount.Value
end

local function sellSaukuryn()
    local buyRemote = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("BuyStallItem")
    if not buyRemote then warn("[cycle] BuyStallItem missing"); return false end

    local root, order
    for i = 1, 30 do
        root = friendRoot()
        order = friendOrder()
        if root and order then break end
        task.wait(2)
    end
    if not root then warn("[cycle] friend stall not found"); return false end
    if not order then warn("[cycle] friend order not found"); return false end

    local l3Before = friendL3Amount(order.index)
    for a = 1, 20 do
        pcall(function() buyRemote:FireServer(root, ITEM_NAME, order.price, 1, order.index) end)
        task.wait(3)
        local l3After = friendL3Amount(order.index)
        local sv = speciesSaukuryn()
        if (l3After ~= nil and l3Before ~= nil and l3After < l3Before) or (sv == 0) then
            warn("[cycle] sold " .. ITEM_NAME .. " (species=" .. tostring(sv) .. " L3=" .. tostring(l3After) .. ")")
            return true
        end
    end
    warn("[cycle] sell failed (species=" .. tostring(speciesSaukuryn()) .. " L3=" .. tostring(friendL3Amount(order.index)) .. ")")
    return false
end

local function goToFriend()
    local lp = LP()
    if not lp then warn("[cycle] no LocalPlayer"); return false end
    local ok, pages = pcall(function() return lp:GetFriendsOnline(200) end)
    if not ok or not pages then warn("[cycle] no friends list"); return false end
    local friends = pages
    if type(pages) == "userdata" then
        local okc, cur = pcall(function() return pages:GetCurrentPage() end)
        if okc then friends = cur end
    end
    if type(friends) ~= "table" then warn("[cycle] bad friends format"); return false end

    for _, f in ipairs(friends) do
        local name = f.UserName or f.Username or f.DisplayName
        if name == FRIEND_NAME then
            local gameId = f.GameId
            warn("[cycle] friend: place=" .. tostring(f.PlaceId) .. " gameId=" .. tostring(gameId))
            if gameId then
                local tok, terr = pcall(function() TS:TeleportToPlaceInstance(TRADE_PLACE, gameId) end)
                if tok then return true end
                warn("[cycle] teleport failed: " .. tostring(terr))
                return false
            end
            warn("[cycle] friend has no gameId")
            return false
        end
    end
    warn("[cycle] friend not online")
    return false
end

task.spawn(function()
    while not getgenv()._stop do
        local shouldBreak = false
        local ok, err = pcall(function()
            if not waitReady() then return end

            if game.PlaceId == MAIN_PLACE then
                local v = speciesSaukuryn()
                warn("[cycle] main place, species." .. ITEM_NAME .. " = " .. tostring(v))
                if v == 1 then
                    if goToFriend() then shouldBreak = true end
                elseif v == 0 then
                    if getSaukuryn() then
                        task.wait(1)
                        if goToFriend() then shouldBreak = true end
                    end
                else
                    warn("[cycle] species." .. ITEM_NAME .. " not found in PlayerData")
                end
            elseif game.PlaceId == TRADE_PLACE then
                if Players:FindFirstChild(FRIEND_NAME) then
                    sellSaukuryn()
                else
                    warn("[cycle] friend not in this server, going back")
                end
                task.wait(1)
                pcall(function() TS:Teleport(MAIN_PLACE, LP()) end)
                shouldBreak = true
            else
                warn("[cycle] unknown place: " .. tostring(game.PlaceId))
            end
        end)
        if not ok then warn("[cycle] error: " .. tostring(err)) end
        if shouldBreak then break end
        task.wait(4)
    end
    warn("[cycle] stopped")
end)
